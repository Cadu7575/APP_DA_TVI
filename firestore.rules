rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{path=**}/partidas/{partidaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{path=**}/lances/{lanceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{path=**}/jogadores/{jogadorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /campeonatos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
      match /{allSubpaths=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /usuarios/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
